#!/usr/bin/env php
<?php

/*
 * Turns benchmarks/results/*.json into benchmarks/results/README.md and the SVG charts
 * in _media/benchmarks that the blog post uses.
 *
 *   php benchmarks/report
 */

declare(strict_types=1);

namespace Bench;

require __DIR__.'/src/Support.php';
require __DIR__.'/src/Svg.php';

const NAMES = [
    'hyde' => 'Hyde 2.0.3, default theme',
    'hyde-patched' => 'Hyde + fix, default theme',
    'hyde-minimal' => 'Hyde 2.0.3',
    'hyde-minimal-patched' => 'Hyde + fix',
    'hyde-minimal-tree' => 'Hyde + fix + tree fix',
    'hyde-tree' => 'Hyde + fix + tree fix, default theme',
    'jigsaw' => 'Jigsaw',
    'jigsaw-commonmark' => 'Jigsaw (CommonMark)',
    'sculpin' => 'Sculpin',
    'hugo' => 'Hugo',
    'eleventy' => 'Eleventy',
    'jekyll' => 'Jekyll',
    'jekyll-disk-cache' => 'Jekyll, disk cache on',
];

$results = [];
foreach (glob(Paths::results('*.json')) as $file) {
    $results[basename($file, '.json')] = json_decode(file_get_contents($file), true);
}

$charts = Paths::root('_media/benchmarks');
@mkdir($charts, recursive: true);

$md = "# Results\n\nGenerated by `php benchmarks/report` from the JSON files in this directory. ";
$md .= "Times are the median wall-clock time of a full, cold build, in seconds. Memory is peak resident set size.\n\n";

$machine = reset($results)['machine'];
$md .= "**Machine:** {$machine['cpu']}, {$machine['cores']} cores, {$machine['memory_gb']} GB RAM, {$machine['os']}. ";
$md .= "PHP {$machine['php']}, Node {$machine['node']}, Ruby {$machine['ruby']}.\n\n";

// --- compare ---------------------------------------------------------------------------------

if (isset($results['compare'])) {
    $cases = $results['compare']['cases'];
    $md .= "## Every generator, same site\n\n";
    $md .= "Same posts and the same minimal layout everywhere, plus a home page listing every post. ";
    $md .= "The two \"default theme\" rows are Hyde exactly as it ships, with its full theme, RSS feed and sitemap.\n\n";

    $sizes = array_values(array_unique(array_column($cases, 'posts')));
    sort($sizes);
    $md .= '| Generator | Version | '.implode(' | ', array_map(fn ($s) => number_format($s).' posts', $sizes))." | Peak memory (largest) |\n";
    $md .= '| --- | --- | '.str_repeat('---: | ', count($sizes))."---: |\n";

    foreach (array_keys(NAMES) as $label) {
        $row = array_values(array_filter($cases, fn ($c) => $c['label'] === $label));
        if (! $row) {
            continue;
        }
        $bySize = array_column($row, null, 'posts');
        $largest = $bySize[max(array_keys($bySize))];
        $md .= sprintf("| %s | %s | %s | %s MB |\n",
            NAMES[$label],
            $row[0]['version'],
            implode(' | ', array_map(fn ($s) => isset($bySize[$s]) ? seconds($bySize[$s]) : '–', $sizes)),
            number_format($largest['summary']['max_rss_mb']['median']),
        );
    }
    $md .= "\nRuns marked with * were measured once, because one build takes many minutes.\n\n";

    foreach ([10000] as $size) {
        $rows = [];
        foreach (['hyde-minimal', 'hyde-minimal-patched', 'jigsaw', 'jigsaw-commonmark', 'sculpin', 'hugo', 'eleventy', 'jekyll'] as $label) {
            $case = find($cases, $label, $size);
            if (! $case) {
                continue;
            }
            $wall = $case['summary']['wall']['median'];
            $rows[] = [
                'label' => NAMES[$label],
                'value' => $wall,
                'class' => match ($label) {
                    'hyde-minimal' => Svg::ORANGE,
                    'hyde-minimal-patched' => Svg::BLUE,
                    default => Svg::MUTED,
                },
                'text' => duration($wall),
            ];
        }
        if (! $rows) {
            continue;
        }
        usort($rows, fn ($a, $b) => $a['value'] <=> $b['value']);

        // Leave the outlier off the scale, so everyone else is still readable.
        $values = array_column($rows, 'value');
        sort($values);
        $cap = end($values) > 3 * $values[count($values) - 2] ? $values[count($values) - 2] * 1.25 : null;

        $once = array_filter([find($cases, 'hyde-minimal', $size)], fn ($c) => $c && count($c['runs']) === 1);
        file_put_contents("$charts/compare-$size.svg", Svg::bars(
            'Build time for '.number_format($size).' blog posts',
            'Median of 5 cold builds'.($once ? ' (Hyde 2.0.3: one build)' : '').'. Same posts, same minimal layout. Lower is better.',
            $rows,
            [[Svg::ORANGE, 'Hyde 2.0.3'], [Svg::BLUE, 'Hyde with the fix'], [Svg::MUTED, 'Other generators']],
            $cap,
        ));
    }
}

// --- scaling ---------------------------------------------------------------------------------

if (isset($results['scaling'])) {
    $cases = [...$results['scaling']['cases'], ...($results['scaling-large']['cases'] ?? [])];
    $md .= "## How build time grows with post count\n\n";
    $md .= "| Posts | Hyde 2.0.3 | Hyde + fix | Hyde + fix, default theme | Hyde 2.0.3, per post | Hyde + fix, per post |\n";
    $md .= "| ---: | ---: | ---: | ---: | ---: | ---: |\n";

    $sizes = array_values(array_unique(array_column($cases, 'posts')));
    sort($sizes);
    foreach ($sizes as $size) {
        $stock = find($cases, 'hyde-minimal', $size);
        $fixed = find($cases, 'hyde-minimal-patched', $size);
        $theme = find($cases, 'hyde-patched', $size);
        $md .= sprintf("| %s | %s | %s | %s | %s | %s |\n",
            number_format($size),
            $stock ? seconds($stock) : '–',
            $fixed ? seconds($fixed) : '–',
            $theme ? seconds($theme) : '–',
            $stock ? perPost($stock) : '–',
            $fixed ? perPost($fixed) : '–',
        );
    }
    $md .= "\n";

    // Every suite that measured a label at the default settings contributes points, later suites win.
    $everything = [...($results['compare']['cases'] ?? []), ...$cases];
    $series = function (string $label, int $upTo) use ($everything) {
        $points = [];
        foreach ($everything as $case) {
            if ($case['label'] === $label && $case['posts'] <= $upTo && $case['content'] === 'medium' && ! $case['cpus']) {
                $points[$case['posts']] = [$case['posts'], $case['summary']['wall']['median']];
            }
        }
        ksort($points);

        return array_values($points);
    };

    file_put_contents("$charts/scaling.svg", Svg::lines(
        'Hyde build time as the blog grows',
        'Seconds for a full build, minimal layout. Lower is better.',
        [
            ['label' => 'Hyde 2.0.3', 'class' => Svg::ORANGE, 'points' => $series('hyde-minimal', 5000)],
            ['label' => 'Hyde with the fix', 'class' => Svg::BLUE, 'points' => $series('hyde-minimal-patched', 5000)],
        ],
        'Number of posts',
        's',
    ));

    // Cost per post, which is flat when a generator scales linearly.
    $perPost = fn (array $points) => array_map(fn ($p) => [$p[0], $p[1] / $p[0] * 1000], array_filter($points, fn ($p) => $p[0] >= 100));
    file_put_contents("$charts/per-post.svg", Svg::lines(
        'Time per post',
        'Total build time divided by the number of posts, in milliseconds. Flat means linear.',
        [
            ['label' => 'Hyde 2.0.3', 'class' => Svg::ORANGE, 'points' => array_values($perPost($series('hyde-minimal', PHP_INT_MAX)))],
            ['label' => 'Hyde with the fix', 'class' => Svg::BLUE, 'points' => array_values($perPost($series('hyde-minimal-patched', PHP_INT_MAX)))],
            ['label' => 'Jigsaw', 'class' => Svg::AQUA, 'points' => array_values($perPost(jigsawPoints($results)))],
        ],
        'Number of posts (log scale)',
        'ms',
        logX: true,
    ));
}

// --- content ---------------------------------------------------------------------------------

if (isset($results['content'])) {
    $cases = $results['content']['cases'];
    $md .= "## Post length\n\n1,000 posts each time. Short posts are about 350 words, medium about 870, long about 2,400.\n\n";
    $md .= "| Generator | Short | Medium | Long | Long ÷ short |\n| --- | ---: | ---: | ---: | ---: |\n";
    foreach (array_keys(NAMES) as $label) {
        $by = [];
        foreach ($cases as $case) {
            if ($case['label'] === $label) {
                $by[$case['content']] = $case;
            }
        }
        if (count($by) < 3) {
            continue;
        }
        $md .= sprintf("| %s | %s | %s | %s | %.1f× |\n", NAMES[$label], seconds($by['short']), seconds($by['medium']), seconds($by['long']),
            $by['long']['summary']['wall']['median'] / $by['short']['summary']['wall']['median']);
    }
    $md .= "\n";
}

// --- php -------------------------------------------------------------------------------------

if (isset($results['php'])) {
    $cases = $results['php']['cases'];
    $md .= "## OPcache and JIT\n\nOPcache is off by default for the PHP CLI. JIT is the tracing JIT with a 128 MB buffer.\n\n";
    $md .= "| Generator | Posts | Default | + OPcache | + OPcache + JIT | JIT vs default |\n| --- | ---: | ---: | ---: | ---: | ---: |\n";
    foreach ($cases as $case) {
        if (str_contains($case['label'], '+')) {
            continue;
        }
        $opcache = find($cases, $case['label'].' +opcache', $case['posts']);
        $jit = find($cases, $case['label'].' +jit', $case['posts']);
        $md .= sprintf("| %s | %s | %s | %s | %s | %s |\n", NAMES[$case['label']], number_format($case['posts']), seconds($case), seconds($opcache), seconds($jit),
            change($case['summary']['wall']['median'], $jit['summary']['wall']['median']));
    }
    $md .= "\n";
}

// --- single core -----------------------------------------------------------------------------

if (isset($results['single-core'], $results['compare'])) {
    $md .= "## One core versus all of them\n\n10,000 posts. The all-core column is from the compare suite, measured in a different session. \"CPU time\" adds up the time spent on every core, so it shows how much work was done regardless of parallelism.\n\n";
    $md .= "| Generator | All {$machine['cores']} cores | 1 core | CPU time (all cores) | Speed-up from more cores |\n| --- | ---: | ---: | ---: | ---: |\n";
    $rows = [];
    foreach ($results['single-core']['cases'] as $single) {
        $all = find($results['compare']['cases'], $single['label'], $single['posts']);
        if (! $all) {
            continue;
        }
        $a = $all['summary']['wall']['median'];
        $b = $single['summary']['wall']['median'];
        $cpu = $all['summary']['user']['median'] + $all['summary']['system']['median'];
        $md .= sprintf("| %s | %s | %s | %.1f s | %.1f× |\n", NAMES[$single['label']], seconds($all), seconds($single), $cpu, $b / $a);
        $rows[] = ['label' => NAMES[$single['label']], 'a' => $a, 'b' => $b, 'text' => sprintf('%.1f× from more cores', $b / $a)];
    }
    usort($rows, fn ($x, $y) => $x['b'] <=> $y['b']);
    $md .= "\n";

    // No chart: the single-core and all-core numbers come from different runs, so a side-by-side chart would overstate them.
}

// --- startup, jekyll cache, tree --------------------------------------------------------------

if (isset($results['startup'])) {
    $md .= "## Startup\n\nA site with a single post, so nearly all of the time is starting up.\n\n| Generator | Time | Peak memory |\n| --- | ---: | ---: |\n";
    foreach ($results['startup']['cases'] as $case) {
        $md .= sprintf("| %s | %s | %s MB |\n", NAMES[$case['label']], seconds($case), number_format($case['summary']['max_rss_mb']['median']));
    }
    $md .= "\n";
}

if (isset($results['jekyll-cache'])) {
    $md .= "## Jekyll's disk cache\n\nJekyll 4 caches converted Markdown between builds by default. The warm-up build fills the cache.\n\n| Setting | 1,000 posts |\n| --- | ---: |\n";
    foreach ($results['jekyll-cache']['cases'] as $case) {
        $md .= sprintf("| %s | %s |\n", NAMES[$case['label']], seconds($case));
    }
    $md .= "\n";
}

foreach (['tree-compare' => 'measured side by side', 'tree' => 'a separate run'] as $suite => $how) {
    if (! isset($results[$suite])) {
        continue;
    }
    $md .= "## Freeing the syntax tree ($how)\n\n| Variant | Posts | Time | Per post | Peak memory |\n| --- | ---: | ---: | ---: | ---: |\n";
    $cases = $results[$suite]['cases'];
    usort($cases, fn ($a, $b) => [$a['posts'], $a['label']] <=> [$b['posts'], $b['label']]);
    foreach ($cases as $case) {
        $md .= sprintf("| %s | %s | %s | %s | %s MB |\n", NAMES[$case['label']], number_format($case['posts']), seconds($case), perPost($case), number_format($case['summary']['max_rss_mb']['median']));
    }
    $md .= "\n";
}

// --- markdown --------------------------------------------------------------------------------

if (isset($results['markdown'])) {
    $m = $results['markdown'];
    $md .= "## Markdown alone\n\n{$m['posts']} medium posts converted to HTML in a loop, no files written, no layout.\n\n";
    $md .= "| Converter | Total | Per post |\n| --- | ---: | ---: |\n";
    $names = [
        'hyde' => 'Hyde\'s Markdown::render()',
        'commonmark' => 'league/commonmark + GFM, one converter',
        'commonmark-new' => 'league/commonmark + GFM, new converter per post',
        'php-markdown' => 'michelf/php-markdown (MarkdownExtra)',
    ];
    foreach ($m['results'] as $variant => $r) {
        $md .= sprintf("| %s | %s ms | %.2f ms |\n", $names[$variant], number_format($r['ms']), $r['ms'] / $m['posts']);
    }
    $md .= "\n";
}

file_put_contents(Paths::results('README.md'), $md);
echo "Wrote benchmarks/results/README.md and ".count(glob("$charts/*.svg"))." charts in _media/benchmarks\n";

// --- helpers ---------------------------------------------------------------------------------

function find(array $cases, string $label, int $posts): ?array
{
    foreach ($cases as $case) {
        if ($case['label'] === $label && $case['posts'] === $posts && ($case['content'] ?? 'medium') === 'medium' && ! ($case['cpus'] ?? null)) {
            return $case;
        }
    }

    return null;
}

function seconds(array $case): string
{
    $wall = $case['summary']['wall']['median'];
    $single = count($case['runs']) === 1 ? '*' : '';

    return ($wall < 10 ? number_format($wall, 2) : number_format($wall, 1)).' s'.$single;
}

function duration(float $seconds): string
{
    if ($seconds >= 120) {
        return sprintf('%d min %02d s', intdiv((int) round($seconds), 60), (int) round($seconds) % 60);
    }

    return ($seconds < 10 ? number_format($seconds, 2) : number_format($seconds, 1)).' s';
}

function perPost(array $case): string
{
    return number_format($case['summary']['wall']['median'] / $case['posts'] * 1000, 1).' ms';
}

function change(float $before, float $after): string
{
    $pct = ($after - $before) / $before * 100;

    return sprintf('%+.0f%%', $pct);
}

/** Jigsaw's points for the per-post chart come from whichever suites measured it. */
function jigsawPoints(array $results): array
{
    $points = [];
    foreach (['compare', 'scaling-large'] as $suite) {
        foreach ($results[$suite]['cases'] ?? [] as $case) {
            if ($case['label'] === 'jigsaw' && $case['content'] === 'medium' && ! $case['cpus']) {
                $points[$case['posts']] = [$case['posts'], $case['summary']['wall']['median']];
            }
        }
    }
    ksort($points);

    return array_values($points);
}
