+    protected static function freeSyntaxTree(Node $node): void
+    {
+        $child = $node->firstChild();
+
+        while ($child !== null) {
+            $next = $child->next();
+            static::freeSyntaxTree($child);
+            $child->detach();
+            $child = $next;
+        }
+    }
