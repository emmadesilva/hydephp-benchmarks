<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Bench</title>
</head>
<body>
<header><a href="/index.html">Bench</a></header>
<main>
    <ul>
        {%- assign posts = collections.posts | reverse -%}
        {% for post in posts %}
            <li><a href="{{ post.url }}">{{ post.data.title }}</a> <time>{{ post.date | shortDate }}</time></li>
        {% endfor %}
    </ul>
</main>
</body>
</html>
